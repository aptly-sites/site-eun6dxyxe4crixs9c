{
  "buildCommand": "pnpm --filter @workspace/et-website-v1 run build:vercel",
  "outputDirectory": "artifacts/et-website-v1/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/forms/contact",
      "destination": "/api/forms/contact"
    },
    {
      "source": "/api/owner-lead",
      "destination": "/api/owner-lead"
    },
    {
      "source": "/api/nearby-schools",
      "destination": "/api/nearby-schools"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "BASE_PATH": "/"
  }
}
