{
  "name": "@workspace/et-website-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm server.ts",
    "build": "pnpm sitemap && vite build --config vite.config.ts && vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist/server && tsx scripts/prerender.ts && tsx scripts/audit-prerendered.ts",
    "build:vercel": "pnpm sitemap && vite build --config vite.config.ts && vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist/server && tsx scripts/prerender.ts && tsx scripts/audit-prerendered.ts",
    "prerender": "tsx scripts/prerender.ts",
    "serve": "NODE_ENV=production node --import tsx/esm server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sitemap": "node scripts/run-with-vite.mjs scripts/generate-sitemap.ts",
    "audit:seo": "tsx scripts/seo-audit.ts && tsx scripts/audit-prerendered.ts",
    "test:hero": "bash scripts/run-hero-tests.sh",
    "test:rentals": "node --import tsx/esm --test tests/rental-data.test.ts",
    "test:rentals:render": "node --test tests/rental-render.test.mjs",
    "test:calculators": "node --import tsx/esm --test tests/calculators.test.ts",
    "test:owner-leads": "node --test tests/owner-lead.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "framer-motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "^2.15.2",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "wouter": "^3.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.64.1",
    "express": "^5.2.1",
    "tsx": "catalog:",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  }
}
