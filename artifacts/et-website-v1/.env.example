# EquityTeam site — build-time environment variables (Vite).
# Copy to `.env` for local overrides. Values prefixed with VITE_ are inlined
# into the client/SSR bundle at build time.

# Absolute base URL used to build every absolute URL on the site:
# canonical, og:url, og:image, twitter image, and all JSON-LD schema URLs.
# Single source of truth — see src/lib/siteUrl.ts.
#
# Defaults to https://www.equityteam.com when unset, so production ships the
# correct domain even with no env configured. Override here (or as a Vercel
# Project Environment Variable) only to point a build at a different domain
# (e.g. a staging host). No trailing slash.
VITE_SITE_URL=https://www.equityteam.com

# Google Maps JavaScript API key (used by the NearbyAreasMap component).
VITE_GOOGLE_MAPS_API_KEY=your-key-here

# Server-only Aptly owner leads (never prefix these with VITE_)
APTLY_API_TOKEN=
APTLY_OWNER_LEADS_BOARD_ID=NYfJxvrmJcgeD5Zqv
APTLY_OWNER_LEADS_STAGE="NEW LEAD (M)"
APTLY_EMAIL_USER_ID=
APTLY_EMAIL_CHANNEL_ID=

# Server-side Google key used to re-verify selected Places addresses.
# This may be the same credential as VITE_GOOGLE_MAPS_API_KEY when its API
# restrictions allow both Maps JavaScript/Places and the Geocoding API.
GOOGLE_MAPS_API_KEY=
GREAT_SCHOOLS=
